.git
.gitignore

# Secrets — never bake into the image (docker/sms_config.php is used instead)
sms_config.php
.env

# User uploads (ephemeral on Render anyway) — keep only the protect .htaccess
uploads/
!uploads/.htaccess

# Dev/setup/test scripts — never shipped to the image (run via CLI)
scripts/

# Backups and scratch files
*.bak
*.bak2
*.backup
_*

# Docs/dumps not needed at runtime
*.docx
*.sql
*.txt
nul
